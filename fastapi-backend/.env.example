# Supabase connection details
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API key for AI processing
GEMINI_API_KEY=AIzaSy...

# Google OAuth Credentials (for Google Ads/GA4/GSC integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# URL of the running frontend application
FRONTEND_URL=http://localhost:3000

# Google PageSpeed Insights API key
PAGESPEED_API_KEY=AIzaSy...

# Meta (Facebook/Instagram) App Credentials for Ads data
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# URL for OpenSerp service (if used for SEO tracking)
OPENSERP_URL=http://localhost:7000
